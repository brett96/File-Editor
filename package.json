{
  "name": "file-editor",
  "productName": "File Editor",
  "version": "0.1.8",
  "private": true,
  "description": "Create, edit, convert and password-protect documents (DOCX, PDF, ODT, RTF, Markdown, HTML, TXT), spreadsheets (XLSX, CSV, TSV), presentations (PPTX) and SQLite databases on the web or desktop.",
  "author": "File Editor",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "cross-env ELECTRON=1 vite build && node scripts/build-electron.mjs",
    "dist": "npm run electron:build && electron-builder --publish never",
    "dist:win": "npm run electron:build && electron-builder --win --publish never",
    "dist:mac": "npm run electron:build && electron-builder --mac --publish never",
    "release": "npm run electron:build && electron-builder --publish always",
    "postinstall": "node scripts/copy-runtime-assets.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jxl": "^1.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mediabunny/aac-encoder": "^1.65.2",
    "@mediabunny/flac-encoder": "^1.65.2",
    "@mediabunny/mp3-encoder": "^1.65.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-subscript": "^3.33.1",
    "@tiptap/extension-superscript": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/turndown": "^5.0.6",
    "@univerjs/preset-sheets-core": "^1.4.0",
    "@univerjs/preset-sheets-filter": "^1.4.0",
    "@univerjs/preset-sheets-find-replace": "^1.4.0",
    "@univerjs/preset-sheets-sort": "^1.4.0",
    "@univerjs/presets": "^1.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ag-psd": "^34.2.0",
    "cfb": "^1.2.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "docx": "^9.15.3",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "gifenc": "^1.0.3",
    "heic-to": "^1.6.7",
    "html-to-pdfmake": "^2.5.36",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "mediabunny": "^1.65.2",
    "officecrypto-tool": "^0.0.19",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sql.js": "^1.16.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2",
    "utif2": "^4.1.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.fileeditor.app",
    "productName": "File Editor",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "en-GB",
      "es",
      "fr",
      "de",
      "pt-BR",
      "ja",
      "zh-CN"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "fileAssociations": [
      {
        "ext": [
          "docx",
          "docm",
          "dotx"
        ],
        "name": "Word Document",
        "description": "Word document",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "doc",
          "dot"
        ],
        "name": "Word 97-2003 Document",
        "description": "Word 97-2003 document",
        "role": "Editor",
        "mimeType": "application/msword"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Editor",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "pptx",
          "ppsx",
          "potx"
        ],
        "name": "PowerPoint Presentation",
        "description": "PowerPoint presentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": "odt",
        "name": "OpenDocument Text",
        "description": "OpenDocument text",
        "role": "Editor",
        "mimeType": "application/vnd.oasis.opendocument.text"
      },
      {
        "ext": "rtf",
        "name": "Rich Text Document",
        "description": "Rich text document",
        "role": "Editor",
        "mimeType": "application/rtf"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": "txt",
        "name": "Text Document",
        "description": "Plain text",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "xlsx",
          "xlsm",
          "xltx"
        ],
        "name": "Excel Workbook",
        "description": "Excel workbook",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "description": "Comma-separated values",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "tsv",
          "tab"
        ],
        "name": "TSV File",
        "description": "Tab-separated values",
        "role": "Editor",
        "mimeType": "text/tab-separated-values"
      },
      {
        "ext": [
          "sqlite",
          "sqlite3",
          "db",
          "db3",
          "sdb"
        ],
        "name": "SQLite Database",
        "description": "SQLite database",
        "role": "Editor",
        "mimeType": "application/vnd.sqlite3"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "jfif"
        ],
        "name": "JPEG Image",
        "description": "JPEG image",
        "role": "Editor",
        "mimeType": "image/jpeg"
      },
      {
        "ext": "png",
        "name": "PNG Image",
        "description": "PNG image",
        "role": "Editor",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "webp",
          "avif",
          "heic",
          "heif",
          "jxl"
        ],
        "name": "Modern Image",
        "description": "WebP / AVIF / HEIC image",
        "role": "Editor"
      },
      {
        "ext": [
          "gif",
          "bmp",
          "tif",
          "tiff",
          "ico"
        ],
        "name": "Image",
        "description": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "mp4",
          "m4v",
          "mov",
          "webm",
          "mkv",
          "avi",
          "wmv",
          "flv",
          "mpg",
          "mpeg",
          "3gp",
          "ts",
          "mts"
        ],
        "name": "Video",
        "description": "Video",
        "role": "Editor"
      },
      {
        "ext": [
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg",
          "opus",
          "aac",
          "wma",
          "aiff"
        ],
        "name": "Audio",
        "description": "Audio",
        "role": "Editor"
      },
      {
        "ext": "psd",
        "name": "Photoshop Document",
        "description": "Photoshop document",
        "role": "Editor",
        "mimeType": "image/vnd.adobe.photoshop"
      },
      {
        "ext": "fstudio",
        "name": "File Editor Studio Project",
        "description": "File Editor Studio project",
        "role": "Editor",
        "mimeType": "application/x-file-editor-studio"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "File-Editor-Setup-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "File-Editor-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "brett96",
        "repo": "File-Editor",
        "releaseType": "draft"
      }
    ]
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  }
}
